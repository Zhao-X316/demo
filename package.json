{
  "name": "jiaofu-suite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:macos": "bash scripts/build_macos_dmg.sh",
    "bundle:macos:debug": "bash scripts/build_macos_dmg.sh --debug",
    "verify:macos:dmg": "bash scripts/verify_macos_dmg.sh",
    "acceptance:t6:build": "tauri build --debug --bundles app --config src-tauri/tauri.acceptance.conf.json",
    "acceptance:subjective:build": "tauri build --debug --bundles app --config src-tauri/tauri.subjective-acceptance.conf.json",
    "acceptance:recitation:build": "tauri build --debug --bundles app --config src-tauri/tauri.recitation-acceptance.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
