{
  "name": "jiaofu-suite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "node scripts/check_project.mjs",
    "check:frontend": "node scripts/check_project.mjs frontend",
    "check:backend": "node scripts/check_project.mjs backend",
    "check:ui": "node scripts/check_project.mjs ui",
    "tauri": "tauri",
    "bundle:macos": "bash scripts/build_macos_dmg.sh",
    "bundle:macos:debug": "bash scripts/build_macos_dmg.sh --debug",
    "verify:macos:dmg": "bash scripts/verify_macos_dmg.sh",
    "check:cargo-target": "bash scripts/check_cargo_target_layout.sh",
    "acceptance:t6:build": "bash scripts/build_acceptance_app.sh src-tauri/tauri.acceptance.conf.json",
    "acceptance:subjective:build": "bash scripts/build_acceptance_app.sh src-tauri/tauri.subjective-acceptance.conf.json",
    "acceptance:recitation:build": "bash scripts/build_acceptance_app.sh src-tauri/tauri.recitation-acceptance.conf.json",
    "acceptance:m25:build": "bash scripts/build_acceptance_app.sh src-tauri/tauri.m25-acceptance.conf.json",
    "acceptance:k1-paper:build": "bash scripts/build_acceptance_app.sh src-tauri/tauri.k1-paper-acceptance.conf.json",
    "acceptance:m6:build": "bash scripts/build_acceptance_app.sh src-tauri/tauri.m6-acceptance.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
